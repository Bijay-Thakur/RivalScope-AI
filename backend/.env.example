# RivalScope backend — copy to .env and fill in keys.

# --- Research LLM ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Prefer GOOGLE_API_KEY; GEMINI_API_KEY also accepted.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

TAVILY_API_KEY=
RESEARCH_MODE=mock

# --- Eval judge (--mode full) ---
# Judge uses its own client (langchain-google-genai / ChatGroq), NOT app llm.py.
# Key resolution: GOOGLE_API_KEY or GEMINI_API_KEY (same as research Gemini).
JUDGE_MODEL=gemini-2.5-pro
# Fallback when primary judge fails: GEMINI_MODEL, then Groq if GROQ_API_KEY set.
# Set true to skip Gemini judge entirely (quota exhausted) and use Groq only.
JUDGE_USE_GROQ=false
JUDGE_MAX_CONCURRENCY=1

# --- LangSmith (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rivalscope-ai
# --- LLM reliability ---
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
FACT_CHECKER_PROVIDER=groq
COMPARISON_PROVIDER=gemini
REPORT_PROVIDER=gemini
