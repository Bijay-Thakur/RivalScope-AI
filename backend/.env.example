GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash

RESEARCH_MODE=mock

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Phase 2 — grounding eval (used by `python -m evals.harness`)
# Judge model should stay a DIFFERENT/stronger tier than GEMINI_MODEL to reduce self-eval bias.
JUDGE_MODEL=gemini-2.5-pro
EVAL_MAX_CONCURRENCY=3

# Phase 2 — LangSmith tracing (optional; app + eval runs auto-trace when enabled)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rivalscope-ai
